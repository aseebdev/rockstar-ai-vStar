NODE_ENV=production

DATABASE_URL=your_supabase_database_url
DATABASE_SSL=true

SESSION_SECRET=your_long_random_session_secret

OWNER_EMAIL=your_email@example.com

# Optional separate encryption secret for stored per-user Astra keys.
# If omitted, SESSION_SECRET is used for backward compatibility.
ASTRA_KEY_ENCRYPTION_SECRET=

ASTRA_BASE_URL=https://api.experientiallabs.ai/v1
ASTRA_MODEL=
ASTRA_MAX_MESSAGES=36
ASTRA_TIMEOUT_MS=30000

DAILY_MESSAGE_LIMIT=20
MONTHLY_MESSAGE_LIMIT=500

TRUST_PROXY=true
ALLOWED_ORIGINS=
# External tools (keep secrets server-side; never expose these to the browser)
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com/search
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Image generation/editing (Cloudflare Workers AI)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
ENABLE_CODE_EXECUTION=false
PISTON_BASE_URL=https://emkc.org/api/v2/piston
PUBLIC_BASE_URL=http://localhost:3000
PISTON_API_KEY=
CRON_SECRET=your_long_random_cron_secret
